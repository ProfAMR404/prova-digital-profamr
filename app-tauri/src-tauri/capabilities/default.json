{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissoes da janela principal da Prova Digital",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/prova-digital-engine",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
